[global]
    workgroup = WORKGROUP
    server string = {{ homelab_hostname }}

    security = user
    map to guest = never

    server min protocol = SMB2
    server max protocol = SMB3

    access based share enum = yes

    log file = /var/log/samba/log.%m
    max log size = 1000

    inherit acls = yes

    create mask = 0660
    directory mask = 2770


[geral]
    path = /mnt/disk/geral
    valid users = @geral
    read only = no
    browseable = yes


[midia]
    path = /mnt/disk/midia
    valid users = @geral
    read only = no
    browseable = yes


[canal]
    path = /mnt/disk/canal
    valid users = @canal
    read only = no
    browseable = yes


{% for user in homelab_users %}
[{{ user.name }}]
    path = /mnt/disk/{{ user.name }}
    valid users = {{ user.name }}
    read only = no
    browseable = yes

{% endfor %}